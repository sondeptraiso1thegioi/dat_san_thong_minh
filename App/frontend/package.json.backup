{
  "name": "sun-sport-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8081",
    "web": "expo start --web --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-navigation/bottom-tabs": "7.15.10",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.14.12",
    "axios": "^1.21.1",
    "expo": "^58.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-location": "~18.0.10",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
